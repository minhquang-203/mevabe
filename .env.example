# --- Secrets & local overrides (copy to .env, do not commit .env) ---
# Spring Boot đọc các biến này từ môi trường. Giá trị dưới đây khớp docker-compose local.

# MySQL (docker compose service mysql, cổng host 3307)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=mevabe_shop
DB_USER=mevabe
DB_PASSWORD=mevabe123

# Docker Compose MySQL (tham khảo — đang hardcode trong docker-compose.yml)
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=mevabe_shop
MYSQL_USER=mevabe
MYSQL_PASSWORD=mevabe123

# JWT — đổi khi làm auth thật, không commit secret production
JWT_SECRET=change-me-please-this-is-a-very-long-dev-secret-key-1234567890

# App
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000
APP_CACHE_PROVIDER=memory
APP_MESSAGING_PROVIDER=log

# Redis / Kafka (chỉ khi bật profile tương ứng)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP=localhost:9092

# Frontend (đặt trong frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
